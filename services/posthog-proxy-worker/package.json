{
  "name": "posthog-proxy-worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "description": "PostHog analytics reverse-proxy on Cloudflare Workers (off-loads events + session replay + flags from Vercel Fast Origin Transfer).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
