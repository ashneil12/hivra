# Caddy front for the noVNC seed viewer.
#
# Static assets are public so noVNC's CSS/JS loads work; the entry HTML and
# the websocket are gated on a signed URL (HMAC, 10-min TTL).
#
# This Caddyfile is only loaded when the container starts with
# SEED_MODE_INNER_CADDY=true (see docker/entrypoint.sh). In normal operation,
# Node serves /health and the tool API directly on :8789 and Caddy is not
# running.

(novnc_gate) {
	forward_auth localhost:8789 {
		uri /internal/verify-novnc-url
		copy_headers X-Original-URI
	}
	reverse_proxy localhost:6080
}

# SCRIPTURE_ANCHOR: caddy-wall | Nehemiah 4:6 | Verse: So we built the wall; and all the wall was joined together to half its height.
:8080 {
	# Caddy path matchers are exact unless the pattern ends in *, so the
	# trailing-slash forms are covered with the wildcard. websockify accepts a
	# websocket upgrade on any path, so every upgrade under the prefix is gated.
	@gated path /browser-sidecar/novnc/vnc.html* /browser-sidecar/novnc/websockify*
	@wsupgrade {
		path /browser-sidecar/novnc/*
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @gated {
		import novnc_gate
	}

	handle @wsupgrade {
		import novnc_gate
	}

	# Static assets fall through — noVNC needs them to load without auth or
	# its CSS/JS won't fetch.
	handle_path /browser-sidecar/novnc/* {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type"
		reverse_proxy localhost:6080
	}
}
