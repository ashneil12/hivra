# --- Service ---
PORT=8789
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=production

# --- Persistence ---
# Where Playwright persistent contexts live. One subdir per identity.
PROFILES_DIR=/var/lib/hermes-browser/profiles
# Where named-flow YAML files live.
FLOWS_DIR=/var/lib/hermes-browser/flows
# Where screenshots are written when callers don't request base64.
SCREENSHOTS_DIR=/var/lib/hermes-browser/screenshots

# --- Auth: HMAC-signed URLs from the dashboard ---
# Shared secret with Hermesdeploy dashboard. Rotated independently.
SIGNING_SECRET=change-me-in-prod-32-bytes-min

# --- Tier revalidation (Layer 2 of tier gating) ---
# Dashboard endpoint the sidecar hits on container start to confirm the
# user's tier still qualifies. If the response is not 200 with tier_ok=true,
# the sidecar exits 0 and the watchdog stops restarting it.
TIER_CHECK_URL=https://dashboard.hermesos.cloud/api/internal/tier-check
TIER_CHECK_INSTANCE_ID=
TIER_CHECK_TOKEN=

# --- Clerk login flow ---
# Used by flows/login_clerk.yaml only. Read once at flow-start, never logged.
CLERK_EMAIL=
CLERK_PASSWORD=
CLERK_LOGIN_URL=https://dashboard.hermesos.cloud/sign-in
CLERK_POST_LOGIN_PATH=/dashboard

# --- IMAP for verification-code retrieval ---
# Hard-clamped to a 60-second polling window in code. Setting these higher
# in this file does not extend the window.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true
IMAP_MAILBOX=INBOX
IMAP_CODE_SUBJECT_PATTERN=(verification|sign-in|login)\s+code|verify\s+your\s+email

# --- noVNC (seeding only) ---
# Internal port the websockify proxy listens on. Caddy gates it behind a
# signed URL with a non-tunable 10-minute TTL.
NOVNC_INTERNAL_PORT=6080
DISPLAY=:99

# --- Playwright ---
# Headless on for normal operation, off only during seeding.
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=0
DEFAULT_NAVIGATION_TIMEOUT_MS=30000
DEFAULT_ACTION_TIMEOUT_MS=15000
