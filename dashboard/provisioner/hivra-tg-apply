#!/usr/bin/env bash
# hivra-tg-apply — narrow root helper for the Hivra chat server to (de)activate
# the bux Telegram bot. Granted to the bux user via a SCOPED NOPASSWD sudoers
# rule (/etc/sudoers.d/hivra-tg) — bux has no general sudo. The tg.env content
# (which contains the secret TG_BOT_TOKEN) is read from STDIN, never from argv.
set -euo pipefail
TG_ENV_DIR=/etc/bux
case "${1:-}" in
  apply)
    umask 027
    install -d -m 2775 -g bux "$TG_ENV_DIR"
    cat > "$TG_ENV_DIR/tg.env"
    chgrp bux "$TG_ENV_DIR/tg.env"
    chmod 640 "$TG_ENV_DIR/tg.env"
    # bux-tg reads tg.env only when it starts, and `enable --now` is a no-op
    # for a bot that is already running, so a new token or pairing link would
    # be ignored. Restart it so the bot always runs with what was just written.
    systemctl enable bux-tg
    systemctl restart bux-tg
    ;;
  disable)
    systemctl disable --now bux-tg 2>/dev/null || true
    rm -f "$TG_ENV_DIR/tg.env"
    ;;
  *)
    echo "usage: hivra-tg-apply apply|disable" >&2
    exit 2
    ;;
esac
