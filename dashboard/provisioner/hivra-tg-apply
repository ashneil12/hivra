#!/usr/bin/env bash
# hivra-tg-apply — narrow root helper for the Hivra chat server to (de)activate
# the bux Telegram bot. Granted to the bux user via a SCOPED NOPASSWD sudoers
# rule (/etc/sudoers.d/hivra-tg) — bux has no general sudo. The tg.env content
# (which contains the secret TG_BOT_TOKEN) is read from STDIN, never from argv.
set -euo pipefail
TG_ENV_DIR=/etc/bux
case "${1:-}" in
  apply)
    umask 027
    install -d -m 2775 -g bux "$TG_ENV_DIR"
    # $TG_ENV_DIR is group-bux-writable (bux owns its tg-state.json / tg-allowed.txt
    # there), so bux can replace the tg.env entry with a symlink. Writing the
    # root-owned secret straight onto that name with `cat >` — and the follow-up
    # chgrp/chmod — would follow such a symlink and let bux redirect a
    # root-authored write to an arbitrary file. Stage the file in the parent
    # dir (/etc, root-only — bux cannot touch it, so the perms steps cannot be
    # raced onto a symlink), then move it into place on the same filesystem:
    # rename(2) replaces the directory entry atomically and never follows a
    # symlink sitting at the destination.
    staging="$(mktemp "$(dirname "$TG_ENV_DIR")/.hivra-tg.env.XXXXXX")"
    trap 'rm -f "$staging"' EXIT
    cat > "$staging"
    chgrp bux "$staging"
    chmod 0640 "$staging"
    mv -f "$staging" "$TG_ENV_DIR/tg.env"
    trap - EXIT
    # bux-tg reads tg.env only when it starts, and `enable --now` is a no-op
    # for a bot that is already running, so a new token or pairing link would
    # be ignored. Restart it so the bot always runs with what was just written.
    systemctl enable bux-tg
    systemctl restart bux-tg
    ;;
  disable)
    systemctl disable --now bux-tg 2>/dev/null || true
    rm -f "$TG_ENV_DIR/tg.env"
    ;;
  *)
    echo "usage: hivra-tg-apply apply|disable" >&2
    exit 2
    ;;
esac
