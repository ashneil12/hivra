#!/usr/bin/env bash
# Native terminal entrypoint. Its systemd unit supplies the agent's HOME/PATH.
# Never replace a missing or unconfigured runtime with a different agent.
set -euo pipefail

# Interactive terminals run inside a persistent tmux session: closing the tab
# or losing the connection detaches instead of ending the work, and the next
# tab re-attaches to the same session. Each terminal has a private socket and
# inline options (-f /dev/null), so the owner's own tmux setup is untouched.
# Mouse mode lets the wheel scroll the session history; Shift+drag still
# selects. Only an interactive terminal (what ttyd starts) is wrapped; otherwise
# persist returns and the caller runs its command directly, as before.
persist() {
  local socket="$1" session="$2" command="$3"
  if [ -t 0 ] && command -v tmux >/dev/null 2>&1; then
    local term=tmux-256color
    infocmp "$term" >/dev/null 2>&1 || term=screen-256color
    # An empty command starts tmux's default: the owner's login shell.
    exec tmux -L "$socket" -f /dev/null \
      start-server \; \
      set-option -g status off \; \
      set-option -g mouse on \; \
      set-option -g escape-time 10 \; \
      set-option -g history-limit 50000 \; \
      set-option -g set-clipboard on \; \
      set-option -g focus-events on \; \
      set-option -g default-terminal "$term" \; \
      set-option -ga terminal-overrides ',xterm-256color:Tc' \; \
      new-session -A -s "$session" ${command:+"$command"}
  fi
}

# The Box Terminal: the owner's general shell, kept alive the same way.
if [ "$#" -eq 1 ] && [ "$1" = "--box-terminal" ]; then
  persist hivra-box box ""
  exec /bin/bash -l
fi

kind_file="${HOME:?HOME is required}/.hivra/agent-kind"
if [ ! -f "$kind_file" ] || [ ! -r "$kind_file" ] || ! kind="$(< "$kind_file")"; then
  printf '%s\n' 'The agent runtime is not configured. Open the box terminal to inspect the installation.' >&2
  exit 78
fi
case "$kind" in
  claude|codex)
    if ! command -v "$kind" >/dev/null 2>&1; then
      printf '%s\n' 'The selected agent runtime is unavailable. Open the box terminal to repair its installation.' >&2
      exit 127
    fi
    # With arguments the CLI runs directly with them, never through a shell.
    if [ "$#" -eq 0 ]; then persist hivra-agent "$kind" "$kind"; fi
    exec "$kind" "$@"
    ;;
  aeon|openclaw|agent-zero|linux-desktop)
    # Dashboard runtimes and Linux computers do not impersonate a coding-agent
    # CLI. Their agent terminal is an ordinary owner shell.
    persist hivra-agent shell ""
    exec /bin/bash -l
    ;;
  deepseek-harness)
    # The native web profile owns the active session. Opening a second CLI
    # owner of its private state is not an attach operation.
    notice='Use the DeepSeek native desktop for sessions. This is your computer shell.'
    persist hivra-agent shell "printf '%s\\n' '$notice'; exec /bin/bash -l"
    printf '%s\n' "$notice"
    exec /bin/bash -l
    ;;
  *)
    printf '%s\n' 'The agent runtime selection is invalid. Open the box terminal to inspect the installation.' >&2
    exit 78
    ;;
esac
