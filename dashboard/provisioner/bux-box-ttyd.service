[Unit]
Description=Hivra box terminal (general shell)
After=network-online.target

[Service]
User=bux
Group=bux
WorkingDirectory=/home/bux
Environment=HOME=/home/bux
Environment=PATH=/home/bux/.npm-global/bin:/home/bux/.bun/bin:/home/bux/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/ttyd -i lo -p 7682 -b /box-terminal -W /bin/bash -l
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
