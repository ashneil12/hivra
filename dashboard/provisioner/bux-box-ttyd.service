[Unit]
Description=Hivra box terminal (general shell)
After=network-online.target

[Service]
User=bux
Group=bux
WorkingDirectory=/home/bux
Environment=HOME=/home/bux
Environment=PATH=/home/bux/.npm-global/bin:/home/bux/.bun/bin:/home/bux/.local/bin:/usr/local/bin:/usr/bin:/bin
# Each session tab runs in a persistent tmux session (hivra-agent-shell); the
# tab's ?arg=N picks the session. Restarting ttyd must not end those sessions.
ExecStart=/usr/local/bin/ttyd -i lo -p 7682 -b /box-terminal -a -W /usr/local/bin/hivra-agent-shell --box-terminal
KillMode=process
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
