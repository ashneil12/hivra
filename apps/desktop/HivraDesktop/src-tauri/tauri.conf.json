{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivra",
  "version": "0.1.0",
  "identifier": "cloud.hivra.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "Hivra",
    "shortDescription": "Give your AI agent a computer of its own.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["hivra"] }
    }
  }
}
