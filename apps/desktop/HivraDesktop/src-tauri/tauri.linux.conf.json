{
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xdg-utils"
        ],
        "files": {
          "/usr/share/applications/Hivra.desktop": "linux/Hivra.desktop"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/applications/Hivra.desktop": "linux/Hivra.desktop"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ashneil12/hivra/releases/download/linux-updates/latest.json"
      ]
    }
  }
}
